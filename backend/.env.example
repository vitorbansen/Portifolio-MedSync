# Servidor
NODE_ENV=development
PORT=3333

# Banco de dados (usado pelo Prisma)
# Host "postgres" é o nome do serviço no docker-compose.
# Para rodar o backend fora do Docker, troque para localhost.
DATABASE_URL=postgresql://medsync:medsync@postgres:5432/medsync?schema=public

# JWT
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=http://localhost:3000

# Cache (opcional — se ausente, o backend opera sem cache)
# Host "redis" é o nome do serviço no docker-compose.
# Para rodar o backend fora do Docker, troque para localhost.
REDIS_URL=redis://redis:6379
CACHE_TTL_MEDICOS=60

# Testes (usado pela suíte Jest; o setup ignora REDIS_URL)
# DATABASE_URL_TEST=postgresql://medsync:medsync@localhost:5432/medsync_test?schema=public
